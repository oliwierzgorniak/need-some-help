@page "/onboarding/4"
@using Radzen
@using Radzen.Blazor
@rendermode RenderMode.InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NeedSomeHelp.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

@using Solnet.Rpc;
@using Solnet.Programs;
@using Solnet.Wallet;


<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.7rem"
    Class="onboarding__container onboarding__container--alt">
    <RadzenStack Gap="0.75rem" AlignItems="AlignItems.End" Class="onboarding__content">
        <RadzenImage Path="assets/onboarding/4.png" Height="1000" Width="1156"
            Class="onboarding__image onboarding__image--large" AlternateText="Crypto features" />
        <RadzenStack Gap="0.25rem" AlignItems="AlignItems.Center"
            Class="onboarding__text-group onboarding__text-group--no-margin">
            <RadzenText Text="Crypto features" TextStyle="TextStyle.H5" TagName="TagName.H2"
                Class="onboarding__headline" />
            <RadzenText
                Text="On Need Some Help, if you wish you can build a trusted history of help and send digital tips using your crypto wallet."
                TextStyle="TextStyle.Body2" TagName="TagName.P" Class="onboarding__subhead" />
        </RadzenStack>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.8rem" AlignItems="AlignItems.Center"
        Class="onboarding__buttons">
        <a href="/">
            <RadzenButton Text="Explore the app" ButtonStyle="ButtonStyle.Primary" Style="white-space: nowrap;" />
        </a>
        <a href="/onboarding/crypto-info">
            <RadzenButton Text="Explain crypto" ButtonStyle="ButtonStyle.Secondary" class="onboarding__button" />
        </a>
    </RadzenStack>
</RadzenStack>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CompleteOnboarding();
        }
    }

    async Task CompleteOnboarding()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "hasVisited", "true");
    }
}