@page "/onboarding/4"
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor
@rendermode RenderMode.InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NeedSomeHelp.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@using Solnet.Rpc;
@using Solnet.Programs;
@using Solnet.Wallet;


<!-- Layout matches Figma Node 62:8180 -->
<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="1.9rem"
    Style="min-height: 100vh; background-color: var(--material-theme-sys-light-background); padding: 1.875rem 0.625rem;">

    <!-- Image + Text Group: Node 112:347 -->
    <RadzenStack Gap="0.75rem" AlignItems="AlignItems.End" Style="width: 18.4375rem; max-width: 100%;">

        <!-- Image: Node 101:305 -->
        <RadzenImage Path="assets/onboarding/4.png" Height="1000" Width="1156"
            Style="width: 100%; height: auto; object-fit: contain;" AlternateText="Crypto features" />

        <!-- Text Group: Node 112:346 -->
        <RadzenStack Gap="0.25rem" AlignItems="AlignItems.Center" Style="width: 100%; text-align: center;">
            <!-- Headline - Headline Medium 28px -->
            <RadzenText Text="Crypto features" TextStyle="TextStyle.H5" TagName="TagName.H2" Style="color: black;" />

            <!-- Subhead - Body Medium 14px -->
            <RadzenText
                Text="On Need Some Help, if you wish you can build a trusted history of help and send digital tips using your crypto wallet."
                TextStyle="TextStyle.Body2" TagName="TagName.P" Style="color: black;" />
        </RadzenStack>

    </RadzenStack>

    <!-- Buttons Group: Node 112:355 -->
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.8rem" AlignItems="AlignItems.Center"
        Style="width: 7.9375rem;">
        <!-- Connect Wallet Button -->
        <a href="/">
            <RadzenButton Text="Explore the app" ButtonStyle="ButtonStyle.Primary" Style="white-space: nowrap;" />
        </a>

        <!-- Skip Button -->
        <a href="./crypto-info">
            <RadzenButton Text="Explain crypto" ButtonStyle="ButtonStyle.Secondary" class="onboarding__button" />
        </a>
    </RadzenStack>

</RadzenStack>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CompleteOnboarding();
        }
    }

    async Task CompleteOnboarding()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "hasVisited", "true");
        Console.WriteLine("Onboarding completed, redirecting to home page.");
    }
}