<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Class="onboarding__container">
    <RadzenStack Gap="1.4375rem" AlignItems="AlignItems.Center" Class="onboarding__content">
        <RadzenImage Path="@ImagePath" Width="1156" Height="1000" Class="onboarding__image"
            AlternateText="@ImageAltText" />
        <RadzenStack Gap="0.375rem" AlignItems="AlignItems.Center" Class="onboarding__text-group">
            <RadzenText Text="@Headline" TextStyle="TextStyle.H4" TagName="TagName.H2" Class="onboarding__headline" />
            <RadzenText Text="@Subhead" TextStyle="TextStyle.Body1" TagName="TagName.P" Class="onboarding__subhead" />
        </RadzenStack>
        <OnboardingNavigation Progress="@Progress" BackUrl="@BackUrl" NextUrl="@NextUrl" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public string ImagePath { get; set; } = "";
    [Parameter] public string ImageAltText { get; set; } = "";
    [Parameter] public string Headline { get; set; } = "";
    [Parameter] public string Subhead { get; set; } = "";
    [Parameter] public double Progress { get; set; }
    [Parameter] public string BackUrl { get; set; } = "";
    [Parameter] public string NextUrl { get; set; } = "";
    [Parameter] public RenderFragment? FooterContent { get; set; }
}