@using Microsoft.AspNetCore.Components
@inject NavigationManager NavigationManager

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
    AlignItems="AlignItems.Center" Class="onboarding__navigation" Style="gap: 48px;">
    <RadzenButton Text="Back" Click="@(args => NavigationManager.NavigateTo(BackUrl))"
        ButtonStyle="ButtonStyle.Secondary" />
    <RadzenButton Text="Next" ButtonStyle="ButtonStyle.Primary"
        Click="@(args => NavigationManager.NavigateTo(NextUrl))" />
</RadzenStack>

@code {
    [Parameter]
    public double Progress { get; set; }

    [Parameter]
    public string BackUrl { get; set; } = "";

    [Parameter]
    public string NextUrl { get; set; } = "";
}