@page "/"
@page "/onboarding/1"
@using Radzen
@using Radzen.Blazor
@inject NavigationManager NavigationManager
@rendermode RenderMode.InteractiveServer

<!-- Layout matches Figma Node 55:6195 -->
<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" 
             Style="min-height: 100vh; background-color: var(--material-theme-sys-light-background); padding: 1.625rem 2.5rem;">

    <!-- Wrapper Node 78:218 -->
    <RadzenStack Gap="1.4375rem" AlignItems="AlignItems.Center" Style="width: 14.9375rem; max-width: 100%;">

        <!-- Content Group Node 78:217 -->
        <RadzenStack Gap="2.4375rem" AlignItems="AlignItems.Center" Style="width: 100%;">
            
            <!-- Image Node 78:212 -->
            <!-- Note: Please ensure 'wwwroot/images/onboarding.png' exists. -->
            <RadzenImage Path="assets/onboarding/1.png" Width="903" Height="1222" Style="width: 13.8125rem; height: 100%; object-fit: cover;" AlternateText="Onboarding Illustration" />

            <!-- Text Group Node 55:6381 -->
            <RadzenStack Gap="0.375rem" AlignItems="AlignItems.Center" Style="width: 100%; text-align: center;">
                
                <!-- Headline Node 55:6197 -->
                <RadzenText Text="Need Some Help" 
                            TagName="TagName.P"
                            Style="font-family: var(--font-headline-large-family); font-weight: var(--font-headline-large-weight); font-size: var(--font-headline-large-size); line-height: var(--font-headline-large-line-height); margin: 0; color: black;" />
                
                <!-- Subhead Node 55:6198 -->
                <RadzenText Text="Where people help each other" 
                            TagName="TagName.P"
                            Style="font-family: var(--font-body-large-family); font-weight: var(--font-body-large-weight); font-size: var(--font-body-large-size); line-height: var(--font-body-large-line-height); letter-spacing: var(--tracking-body-large); margin: 0; color: black;" />
            </RadzenStack>

        </RadzenStack>

        <!-- Button Node 55:6698 -->
        <RadzenButton Text="Next" 
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@OnNextClick"/>
    </RadzenStack>

</RadzenStack>

@code {
    void OnNextClick()
    {
        NavigationManager.NavigateTo("/onboarding/2");
    }
}