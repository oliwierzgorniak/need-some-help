@page "/chats"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using NeedSomeHelp.Data
@using NeedSomeHelp.Components.Pages
@using NeedSomeHelp.Components.Layout
@attribute [Authorize]
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@using NeedSomeHelp.Components.Shared

<PageTitle>Chats</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="scroll-content">
            <RadzenStack Gap="1rem">
                @if (isLoading)
                {
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium"
                        class="loading-spinner" />
                }
                else if (!chatItems.Any())
                {
                    <RadzenText Text="No active chats." TextStyle="TextStyle.Body1" class="empty-state-text"
                        TextAlign="TextAlign.Center" />
                }
                else
                {
                    @foreach (var chat in chatItems)
                    {
                        <a href="@($"chat/{chat.RequestId}")" class="chat-link">
                            <RadzenStack Gap="0.2rem" class="text-content">
                                <RadzenText Text="@chat.OtherUserName" TextStyle="TextStyle.H5" class="user-name" />
                                <RadzenText Text="@chat.RequestTitle" TextStyle="TextStyle.Body2" class="request-title" />
                            </RadzenStack>
                            <a href="@($"profile/{chat.OtherUserId}")">
                                <RadzenButton Icon="person" ButtonStyle="ButtonStyle.Primary" class="icon-button" />
                            </a>
                        </a>
                        <div class="divider"></div>
                    }
                }
            </RadzenStack>
        </div>
        <Nav Section="chats" />
    </Authorized>
    <NotAuthorized>
        <LoginInfo />
        <Nav Section="chats" />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isLoading = true;
    private List<ChatItem> chatItems = new();

    private class ChatItem
    {
        public string OtherUserId { get; set; } = string.Empty;
        public string OtherUserName { get; set; } = "Unknown";
        public string RequestTitle { get; set; } = string.Empty;
        public int RequestId { get; set; }
        public DateTime LastActive { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = UserManager.GetUserId(user);
            if (!string.IsNullOrEmpty(userId))
            {
                // 1. Get requests I contacted (I am the helper, User is the Owner)
                // Show regardless of message existence. Sort by LastMessage ?? ContactedAt
                var myContactedData = await DbContext.Users
                .Where(u => u.Id == userId)
                .SelectMany(u => u.ContactedRequests)
                .Select(cr => new ChatItem
                {
                    OtherUserId = cr.Request.OwnerId,
                    OtherUserName = cr.Request.Owner.Name ?? cr.Request.Owner.UserName ?? "User",
                    RequestTitle = cr.Request.Title,
                    RequestId = cr.RequestId,
                    LastActive = DbContext.Messages
                        .Where(m => m.RequestId == cr.RequestId && (
                            (m.SenderId == userId && m.ReceiverId == cr.Request.OwnerId) || 
                            (m.SenderId == cr.Request.OwnerId && m.ReceiverId == userId)
                        ))
                        .OrderByDescending(m => m.Timestamp)
                        .Select(m => (DateTime?)m.Timestamp)
                        .FirstOrDefault() ?? cr.CreatedAt
                })
                .ToListAsync();

                // 2. Get requests I own that have been contacted (I am the owner, User is the helper)
                // ONLY show if there are messages.
                var requestsIOwnDataQuery = DbContext.HelpRequests
                    .Where(r => r.OwnerId == userId)
                    .SelectMany(r => r.ContactedBy)
                    .Select(cr => new 
                    { 
                        cr, 
                        LastMessageDate = DbContext.Messages
                            .Where(m => m.RequestId == cr.RequestId && (
                                (m.SenderId == userId && m.ReceiverId == cr.UserId) || 
                                (m.SenderId == cr.UserId && m.ReceiverId == userId)
                            ))
                            .OrderByDescending(m => m.Timestamp)
                            .Select(m => (DateTime?)m.Timestamp)
                            .FirstOrDefault()
                    })
                    .Where(x => x.LastMessageDate != null); // Filter out if no messages

                var requestsIOwnData = await requestsIOwnDataQuery
                    .Select(x => new ChatItem
                    {
                        OtherUserId = x.cr.UserId,
                        OtherUserName = x.cr.User.Name ?? x.cr.User.UserName ?? "User",
                        RequestTitle = x.cr.Request.Title,
                        RequestId = x.cr.RequestId,
                        LastActive = x.LastMessageDate.Value
                    })
                    .ToListAsync();

                chatItems = myContactedData.Concat(requestsIOwnData).OrderByDescending(c => c.LastActive).ToList();
            }
        }
        isLoading = false;
    }
}