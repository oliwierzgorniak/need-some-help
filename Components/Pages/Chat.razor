@page "/chats/{UserId}"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NeedSomeHelp.Data
@inject NavigationManager NavigationManager
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Chat</PageTitle>

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: white;
    }

    .chat-header {
        padding: 1rem;
        border-bottom: 1px solid var(--material-theme-sys-light-outline);
        display: flex;
        align-items: center;
        gap: 3rem;
    }

    .chat-header-info {
        flex: 1;
        text-align: center;
    }

    .chat-header-title {
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--material-theme-sys-light-on-background);
        margin: 0;
    }

    .chat-header-subtitle {
        font-size: 0.875rem;
        color: #6b6b6b;
        margin: 0.25rem 0 0 0;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .message {
        display: flex;
        padding: 0.625rem;
        border-radius: 4px;
        max-width: 60%;
        word-wrap: break-word;
        font-size: 0.8125rem;
        line-height: 1.4;
    }

    .message.received {
        align-self: flex-start;
        background-color: var(--material-theme-sys-light-surface-dim);
        color: var(--material-theme-sys-light-on-background);
    }

    .message.sent {
        align-self: flex-end;
        background-color: var(--material-theme-sys-light-secondary-container);
        color: var(--material-theme-sys-light-on-secondary-container);
    }

    .chat-input-container {
        padding: 1rem;
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .chat-input-wrapper {
        flex: 1;
        display: flex;
    }

    .send-button {
        height: 100%;
        aspect-ratio: 1/1;
    }
</style>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <a href="/">
            <RadzenIcon Icon="arrow_back" Style="cursor: pointer; font-size: 1.5rem;"
                Click="@(() => NavigationManager.NavigateTo("/"))" />
        </a>
        <div class="chat-header-info">
            <p class="chat-header-title">@(ContactName ?? "User")</p>
            <p class="chat-header-subtitle">@(RequestTitle ?? "Help request")</p>
        </div>
        <RadzenButton Icon="person" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
            Style="border-radius: 4px; padding: 0.5rem 0.375rem;" class="icon-filled" />
    </div>

    <!-- Messages -->
    <div class="chat-messages">
        @foreach (var msg in messages)
        {
            <div class="message @(msg.IsReceived ? "received" : "sent")">
                <RadzenText Text="@msg.Text" Style="margin: 0;" TextStyle="TextStyle.Body2" />
            </div>
        }
    </div>

    <!-- Input Area -->
    <div class="chat-input-container">
        <RadzenTextBox @bind-Value="@messageInput" Placeholder="Text" Style="flex: 1;" />
        <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Click="@SendMessage"
            class="send-button" />
    </div>
</div>

@code {
    [Parameter]
    public String UserId { get; set; }

    private string ContactName = "Loading...";
    private string RequestTitle = "Help request"; // TODO: Should likely be dynamic based on a RequestId context too
    private string messageInput = "";
    private List<ChatMessage> messages = new();
    private ApplicationUser? CurrentUser;

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsReceived { get; set; }
        public DateTime Timestamp { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            CurrentUser = await UserManager.GetUserAsync(user);
            if (CurrentUser != null)
            {
                await LoadChatData();
            }
        }
        else
        {
            // Redirect to login if needed, or handle unauthenticated state
            NavigationManager.NavigateTo("Identity/Account/Login", true);
        }
    }

    private async Task LoadChatData()
    {
        if (CurrentUser == null) return;

        // 1. Get the other user's info
        var otherUser = await DbContext.Users.FindAsync(UserId);
        if (otherUser != null)
        {
            ContactName = otherUser.Name ?? "Unknown";
        }

        // 2. Fetch messages between CurrentUser and the other User (UserId)
        var dbMessages = await DbContext.Messages
        .Where(m => (m.SenderId == CurrentUser.Id && m.ReceiverId == UserId) ||
        (m.SenderId == UserId && m.ReceiverId == CurrentUser.Id))
        .OrderBy(m => m.Timestamp)
        .ToListAsync();

        messages = dbMessages.Select(m => new ChatMessage
        {
            Text = m.Content,
            IsReceived = m.SenderId != CurrentUser.Id,
            Timestamp = m.Timestamp
        }).ToList();
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(messageInput) && CurrentUser != null)
        {
            var newMessage = new Message
            {
                SenderId = CurrentUser.Id,
                ReceiverId = UserId,
                Content = messageInput,
                Timestamp = DateTime.UtcNow
            };

            DbContext.Messages.Add(newMessage);
            await DbContext.SaveChangesAsync();

            messages.Add(new ChatMessage { Text = messageInput, IsReceived = false, Timestamp = newMessage.Timestamp });
            messageInput = "";
        }
    }
}