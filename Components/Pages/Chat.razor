@page "/chats/{UserId}"
@using Microsoft.AspNetCore.Components
@inject NavigationManager NavigationManager

<PageTitle>Chat</PageTitle>

<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: white;
    }

    .chat-header {
        padding: 1rem;
        border-bottom: 1px solid var(--material-theme-sys-light-outline);
        display: flex;
        align-items: center;
        gap: 3rem;
    }

    .chat-header-info {
        flex: 1;
        text-align: center;
    }

    .chat-header-title {
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--material-theme-sys-light-on-background);
        margin: 0;
    }

    .chat-header-subtitle {
        font-size: 0.875rem;
        color: #6b6b6b;
        margin: 0.25rem 0 0 0;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .message {
        display: flex;
        padding: 0.625rem;
        border-radius: 4px;
        max-width: 60%;
        word-wrap: break-word;
        font-size: 0.8125rem;
        line-height: 1.4;
    }

    .message.received {
        align-self: flex-start;
        background-color: var(--material-theme-sys-light-surface-dim);
        color: var(--material-theme-sys-light-on-background);
    }

    .message.sent {
        align-self: flex-end;
        background-color: var(--material-theme-sys-light-secondary-container);
        color: var(--material-theme-sys-light-on-secondary-container);
    }

    .chat-input-container {
        padding: 1rem;
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .chat-input-wrapper {
        flex: 1;
        display: flex;
    }

    .send-button {
        height: 100%;
        aspect-ratio: 1/1;
    }
</style>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
      <a href="/">
        <RadzenIcon Icon="arrow_back" Style="cursor: pointer; font-size: 1.5rem;" Click="@(() => NavigationManager.NavigateTo("/"))" />
      </a>
        <div class="chat-header-info">
            <p class="chat-header-title">@(ContactName ?? "User")</p>
            <p class="chat-header-subtitle">@(RequestTitle ?? "Help request")</p>
        </div>
        <RadzenButton Icon="person" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Style="border-radius: 4px; padding: 0.5rem 0.375rem;"  class="icon-filled"/>
    </div>

    <!-- Messages -->
    <div class="chat-messages">
        @foreach (var msg in messages)
        {
            <div class="message @(msg.IsReceived ? "received" : "sent")">
              <RadzenText Text="@msg.Text" Style="margin: 0;" TextStyle="TextStyle.Body2" />
            </div>
        }
    </div>

    <!-- Input Area -->
    <div class="chat-input-container">
        <RadzenTextBox @bind-Value="@messageInput" Placeholder="Text" Style="flex: 1;" />
        <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Click="@SendMessage" class="send-button" />
    </div>
</div>

@code {
            [Parameter]
            public String UserId { get; set; }

    private string ContactName = "Anne";
    private string RequestTitle = "Help with gardening";
    private string messageInput = "";
    private List<ChatMessage> messages = new()
    {
        new ChatMessage { Text = "Let's meet at 14:00", IsReceived = true },
        new ChatMessage { Text = "Sounds ok", IsReceived = false },
        new ChatMessage { Text = "Let's meet at 14:00", IsReceived = true }
    };

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsReceived { get; set; }
    }

    protected override void OnInitialized()
    {
        Console.WriteLine($"Chat initialized for User: {UserId}");
        // Load contact info and messages based on UserId
        // TODO: Fetch from API or database
    }

    private void SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(messageInput))
        {
            messages.Add(new ChatMessage { Text = messageInput, IsReceived = false });
            messageInput = "";
            // TODO: Send to server/API
        }
    }
}
