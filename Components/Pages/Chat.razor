@page "/chat/{RequestId:int}/{otherUserId?}"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using NeedSomeHelp.Data
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Chat</PageTitle>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <a href="/chats" class="back">
            <RadzenIcon Icon="arrow_back" />
        </a>
        <div class="chat-header-info">
            <p class="chat-header-title">@(ContactName ?? "User")</p>
            <p class="chat-header-subtitle">@(RequestTitle ?? "Help request")</p>
        </div>
        <a href="@($"/profile/{otherUserId}")" class="profile-button">
            <RadzenButton Icon="person" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" class="icon-filled" />
        </a>
    </div>

    <!-- Messages -->
    <div class="chat-messages">
        @foreach (var msg in messages)
        {
            <div class="message @(msg.IsReceived ? "received" : "sent")">
                <RadzenText Text="@msg.Text" TextStyle="TextStyle.Body2" class="message-text" />
            </div>
        }
    </div>

    <!-- Input Area -->
    <div class="chat-input-container">
        <RadzenTextBox @bind-Value="@messageInput" Placeholder="Text" class="message-textbox"
            @onkeydown="@HandleKeyPress" />
        <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Click="@SendMessage"
            class="send-button" />
    </div>
</div>

@code {
    [Parameter]
    public int RequestId { get; set; }

    [Parameter]
    public string? otherUserId { get; set; }

    private string ContactName = "Loading...";
    private string RequestTitle = "Loading...";
    private string messageInput = "";
    private List<ChatMessage> messages = new();
    private ApplicationUser? currentUser;
    private HubConnection? hubConnection;

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsReceived { get; set; }
        public DateTime Timestamp { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true) NavigationManager.NavigateTo("/login", true);

        currentUser = await UserManager.GetUserAsync(user);
        if (currentUser != null)
        {
            try
            {
                await LoadChatData();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading chat data: {ex.Message}");
            }

            if (!string.IsNullOrEmpty(otherUserId))
            {
                await StartSignalRConnection();
            }
        }
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

            hubConnection.On<string, string>("ReceiveMessage", (senderId, content) =>
            {
                if (currentUser != null && senderId != currentUser.Id)
                {
                    messages.Add(new ChatMessage
                    {
                        Text = content,
                        IsReceived = true,
                        Timestamp = DateTime.UtcNow
                    });
                    InvokeAsync(async () =>
        {
                StateHasChanged();
                await ScrollToBottom();
            });
                }
            });

            await hubConnection.StartAsync();
            await hubConnection.SendAsync("JoinChat", RequestId, currentUser!.Id, otherUserId!);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not start SignalR connection: {ex.Message}");
        }
    }

    private async Task LoadChatData()
    {
        if (currentUser == null) return;
        using var dbContext = await DbContextFactory.CreateDbContextAsync();

        await LoadChatInfo(dbContext);
        await LoadMessages(dbContext);
    }

    private async Task LoadChatInfo(ApplicationDbContext dbContext)
    {
        // 1. Get the Help Request info for context
        var request = await dbContext.HelpRequests
        .Include(r => r.Owner)
        .Include(r => r.ContactedBy)
        .FirstOrDefaultAsync(r => r.Id == RequestId);

        if (request == null) return;

        RequestTitle = request.Title;

        // Get details for the header
        if (!string.IsNullOrEmpty(otherUserId))
        {
            var otherUser = await dbContext.Users.FindAsync(otherUserId);
            if (otherUser != null)
            {
                ContactName = otherUser.Name ?? otherUser.UserName ?? "User";
            }
        }
    }

    private async Task LoadMessages(ApplicationDbContext dbContext)
    {
        if (string.IsNullOrEmpty(otherUserId) || currentUser == null) return;

        var dbMessages = await dbContext.Messages
        .Where(m => m.RequestId == RequestId &&
        (
        (m.SenderId == currentUser.Id && m.ReceiverId == otherUserId) ||
        (m.SenderId == otherUserId && m.ReceiverId == currentUser.Id)
        ))
        .OrderBy(m => m.Timestamp)
        .ToListAsync();

        messages = dbMessages.Select(m => new ChatMessage
        {
            Text = m.Content,
            IsReceived = m.SenderId != currentUser.Id,
            Timestamp = m.Timestamp
        }).ToList();
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(messageInput) && currentUser != null && !string.IsNullOrEmpty(otherUserId))
        {
            using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var newMessage = new Message
            {
                SenderId = currentUser.Id,
                ReceiverId = otherUserId,
                RequestId = RequestId,
                Content = messageInput,
                Timestamp = DateTime.UtcNow
            };

            dbContext.Messages.Add(newMessage);
            await dbContext.SaveChangesAsync();

            @* Sending also with websockets *@
            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
            {
                try
                {
                    await hubConnection.SendAsync("SendMessage", RequestId, currentUser.Id, otherUserId, messageInput);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error sending real-time update: {ex.Message}");
                }
            }

            @* Adding to UI *@
            messages.Add(new ChatMessage { Text = messageInput, IsReceived = false, Timestamp = newMessage.Timestamp });
            messageInput = "";
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(100);
        await JSRuntime.InvokeVoidAsync("otherInterop.scrollToBottom", ".chat-messages");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
        }
    }

    public async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            try
            {
                await hubConnection.StopAsync();
                await hubConnection.DisposeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error disposing SignalR connection: {ex.Message}");
            }
        }
    }
}