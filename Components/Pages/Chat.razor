@page "/chat/{RequestId:int}"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client
@using NeedSomeHelp.Data
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Chat</PageTitle>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <a href="/chats" class="back">
            <RadzenIcon Icon="arrow_back" />
        </a>
        <div class="chat-header-info">
            <p class="chat-header-title">@(ContactName ?? "User")</p>
            <p class="chat-header-subtitle">@(RequestTitle ?? "Help request")</p>
        </div>
        <a href="@($"/profile/{ProfileUser?.Id}")" class="profile-button">
            <RadzenButton Icon="person" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
            class="icon-filled" />
        </a>
    </div>

    <!-- Messages -->
    <div class="chat-messages">
        @foreach (var msg in messages)
        {
            <div class="message @(msg.IsReceived ? "received" : "sent")">
                <RadzenText Text="@msg.Text" TextStyle="TextStyle.Body2" class="message-text" />
            </div>
        }
    </div>

    <!-- Input Area -->
    <div class="chat-input-container">
        <RadzenTextBox @bind-Value="@messageInput" Placeholder="Text" class="message-textbox" 
            @onkeydown="@HandleKeyPress" />
        <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Click="@SendMessage"
            class="send-button" />
    </div>
</div>

@code {
    [Parameter]
    public int RequestId { get; set; }

    private string ContactName = "Loading...";
    private string RequestTitle = "Loading...";
    private string messageInput = "";
    private List<ChatMessage> messages = new();
    private ApplicationUser? ProfileUser;
    private string? otherUserId;
    private HubConnection? hubConnection;

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsReceived { get; set; }
        public DateTime Timestamp { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            ProfileUser = await UserManager.GetUserAsync(user);
            if (ProfileUser != null)
            {
                try 
                {
                    await LoadChatData();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading chat data: {ex.Message}");
                    // Fallback to empty list or retry logic if needed
                }

                if (!string.IsNullOrEmpty(otherUserId))
                {
                    await StartSignalRConnection();
                }
            }
        }
        else
        {
            NavigationManager.NavigateTo("Identity/Account/Login", true);
        }
    }

    private async Task StartSignalRConnection()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/chathub"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<string, string>("ReceiveMessage", (senderId, content) =>
            {
                if (ProfileUser != null && senderId != ProfileUser.Id)
                {
                    messages.Add(new ChatMessage 
                    { 
                        Text = content, 
                        IsReceived = true, 
                        Timestamp = DateTime.UtcNow 
                    });
                    InvokeAsync(async () => 
                    {
                        StateHasChanged();
                        await ScrollToBottom();
                    });
                }
            });

            await hubConnection.StartAsync();
            await hubConnection.SendAsync("JoinChat", RequestId, ProfileUser!.Id, otherUserId!);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not start SignalR connection: {ex.Message}");
            // We don't throw here, so the page still works in "offline" mode (just DB)
        }
    }

    private async Task LoadChatData()
    {
        if (ProfileUser == null) return;

        // 1. Get the Help Request info for context
        var request = await DbContext.HelpRequests
            .Include(r => r.Owner)
            .Include(r => r.ContactedBy)
            .FirstOrDefaultAsync(r => r.Id == RequestId);

        if (request != null)
        {
            RequestTitle = request.Title;
        }
        else 
        {
            return;
        }

        // 2. Identify "Other User" for header display
        otherUserId = string.Empty;

        if (ProfileUser.Id == request.OwnerId)
        {
            // First check if there are any existing messages from someone else in this channel
            var activePartnerId = await DbContext.Messages
                .Where(m => m.RequestId == RequestId && m.SenderId != ProfileUser.Id)
                .Select(m => m.SenderId)
                .FirstOrDefaultAsync();

            if (!string.IsNullOrEmpty(activePartnerId))
            {
                 otherUserId = activePartnerId;
            }
            else if (request.ContactedBy.Any())
            {
                 otherUserId = request.ContactedBy.First().UserId;
            }
        }
        else
        {
             otherUserId = request.OwnerId;
        }

        if (!string.IsNullOrEmpty(otherUserId))
        {
             var otherUser = await DbContext.Users.FindAsync(otherUserId);
             if (otherUser != null)
             {
                 ContactName = otherUser.Name ?? otherUser.UserName ?? "User";
             }
        }

        // 3. Fetch messages for this REQUEST
        var dbMessages = await DbContext.Messages
        .Where(m => m.RequestId == RequestId)
        .OrderBy(m => m.Timestamp)
        .ToListAsync();

        messages = dbMessages.Select(m => new ChatMessage
        {
            Text = m.Content,
            IsReceived = m.SenderId != ProfileUser.Id,
            Timestamp = m.Timestamp
        }).ToList();
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(messageInput) && ProfileUser != null)
        {
            // Determine receiver based on context
            // If I am the Owner (CurrentUser.Id == request.OwnerId), then the receiver must be inferred from the context.
            // BUT, without a UserId in the URL, if I have multiple people contacting me, this single page is ambiguous.
            // However, following the instruction "based on the requestId look up in db other users name (not logged in - the other)",
            // implies we just find "the other one".
            
            // Re-fetch request to be sure (it's cached in EF usually but safety first)
            var request = await DbContext.HelpRequests.FindAsync(RequestId);
            if (request == null) return;

            string receiverId = string.Empty;

            if (ProfileUser.Id == request.OwnerId)
            {
               // I am the owner. Who am I talking to?
               // The instruction implies there IS an "other user".
               // Query the messages for this RequestId to find someone who isn't me.
               var lastMessage = await DbContext.Messages
                   .Where(m => m.RequestId == RequestId && m.SenderId != ProfileUser.Id)
                   .OrderByDescending(m => m.Timestamp)
                   .FirstOrDefaultAsync();
                   
               if (lastMessage != null)
               {
                   receiverId = lastMessage.SenderId;
               }
               else 
               {
                   // No messages yet? Then we can check the ContactedByUsers list.
                   // We need to fetch it explicitly
                   var reqWithContacts = await DbContext.HelpRequests
                      .Include(r => r.ContactedBy)
                      .FirstOrDefaultAsync(r => r.Id == RequestId);
                      
                   if (reqWithContacts != null && reqWithContacts.ContactedBy.Any())
                   {
                        // Logic: Pick the first or most recent contact? 
                        // If the user insists on /chat/{RequestId}, and I am the owner, and 5 people contacted me...
                        // This logic forces a collision unless we assume 1 helper.
                        // We'll pick the first one for now as a fallback.
                        receiverId = reqWithContacts.ContactedBy.First().UserId;
                   }
               }
            }
            else
            {
                // I am the helper. Receiver is the owner.
                receiverId = request.OwnerId;
            }

            if (string.IsNullOrEmpty(receiverId)) return; // Can't send if we don't know who to.

            var newMessage = new Message
            {
                SenderId = ProfileUser.Id,
                ReceiverId = receiverId,
                RequestId = RequestId,
                Content = messageInput,
                Timestamp = DateTime.UtcNow
            };

            DbContext.Messages.Add(newMessage);
            await DbContext.SaveChangesAsync();

            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
            {
                try 
                {
                    await hubConnection.SendAsync("SendMessage", RequestId, ProfileUser.Id, receiverId, messageInput);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error sending real-time update: {ex.Message}");
                }
            }

            messages.Add(new ChatMessage { Text = messageInput, IsReceived = false, Timestamp = newMessage.Timestamp });
            messageInput = "";
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(100);
        await JSRuntime.InvokeVoidAsync("otherInterop.scrollToBottom", ".chat-messages");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();
        }
    }

    public async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            try 
            {
                await hubConnection.StopAsync();
                await hubConnection.DisposeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error disposing SignalR connection: {ex.Message}");
            }
        }
    }
}