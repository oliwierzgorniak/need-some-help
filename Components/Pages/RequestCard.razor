<a href="@($"request/{Id}")" class="link">
    <RadzenStack Gap="0.625em" class="card-container">
        <RadzenImage Path="@(string.IsNullOrEmpty(PhotoUrl) ? "assets/request-no-picture.jpg" : PhotoUrl)"
            class="request-image" AlternateText="Help request image" />
        <div class="content">
            <RadzenText Text="@Title" TextStyle="TextStyle.H5" class="title" />
            <RadzenText Text="@(Location == "" ? "Location unknown" : Location)" TextStyle="TextStyle.Body1"
                class="location" />
        </div>
    </RadzenStack>
</a>

@code {
    [Parameter]
    public string Title { get; set; } = "Title";

    [Parameter]
    public string Location { get; set; } = "Location unknown";

    [Parameter]
    public int Id { get; set; } = 0;

    [Parameter]
    public string? PhotoUrl { get; set; }
}