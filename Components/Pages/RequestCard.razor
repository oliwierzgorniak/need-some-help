<a href="@($"request/{Id}")">
    <RadzenStack Gap="0.625em"
        Style="background-color: var(--material-theme-sys-light-surface); border: 1px solid var(--material-theme-sys-light-outline-variant); border-radius: 0.25rem; padding: 0.625rem;">
        <!-- Image Container -->
        <RadzenImage Path="@($"assets/requests/{Id}.png")"
            Style="width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 0.25rem;"
            AlternateText="Help request image" />
        <!-- Content -->
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center;">
            <RadzenText Text="@Title" TextStyle="TextStyle.H4"
                Style="color: var(--material-theme-sys-light-on-surface); font-weight: 600;" />
            <RadzenText Text="@Location" TextStyle="TextStyle.Body1"
                Style="color: var(--material-theme-sys-light-on-surface-variant); margin: 0;" />
        </div>
    </RadzenStack>
</a>

@code {
    [Parameter]
    public string Title { get; set; } = "Title";

    [Parameter]
    public string Location { get; set; } = "Location";

    [Parameter]
    public int Id { get; set; } = 0;
}