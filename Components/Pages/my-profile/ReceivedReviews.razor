@page "/my-profile/received-reviews"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using NeedSomeHelp.Data
@using NeedSomeHelp.Components.shared
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<PageTitle>@($"Reviews for {UserName}")</PageTitle>

<ReviewsTemplate BackUrl="@($"/my-profile")" Title="Received Reviews" IsLoading="@IsLoading" reviews="@reviews" />

@code {
  [Parameter]
  public string UserId { get; set; } = string.Empty;

  private bool IsLoading = true;
  private string UserName = "User";
  private List<ReviewsTemplate.ReviewItem> reviews = new();



  private async Task LoadReviews(string userId)
  {
    // 2. Fetch reviews where RevieweeId == UserId
    reviews = await DbContext.Reviews
    .Where(r => r.RevieweeId == userId)
    .Include(r => r.Reviewer)
    .OrderByDescending(r => r.CreatedAt)
    .Select(r => new ReviewsTemplate.ReviewItem
    {
      Id = r.Id,
      UserName = r.Reviewer.Name ?? r.Reviewer.UserName ?? "Unknown",
      Rating = r.Rating,
      Content = r.Content,
      BlockchainSignature = r.BlockchainReference,
      CreatedAt = r.CreatedAt
    })
    .ToListAsync();
  }

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;

    var UserProfile = await UserManager.GetUserAsync(user);
    UserName = UserProfile?.Name ?? UserProfile?.UserName ?? "User";

    var UserId = UserManager.GetUserId(user);

    if (string.IsNullOrEmpty(UserId))
    {
      IsLoading = false;
      return;
    }

    await LoadReviews(UserId);

    IsLoading = false;
  }
}