@page "/my-profile/given-reviews"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using NeedSomeHelp.Data
@using NeedSomeHelp.Components.Shared
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>Given reviews</PageTitle>

<ReviewsTemplate BackUrl="/my-profile" Title="Given Reviews" IsLoading="@IsLoading" reviews="@reviews" />

@code {
  [Parameter]
  public string UserId { get; set; } = string.Empty;

  private bool IsLoading = true;
  private string UserName = "User";
  private List<ReviewsTemplate.ReviewItem> reviews = new();



  private async Task LoadReviews(string userId)
  {
    using var dbContext = await DbContextFactory.CreateDbContextAsync();
    // 2. Fetch reviews where ReviewerId == UserId
    reviews = await dbContext.Reviews
    .Where(r => r.ReviewerId == userId)
    .Include(r => r.Reviewee)
    .OrderByDescending(r => r.CreatedAt)
    .Select(r => new ReviewsTemplate.ReviewItem
    {
      Id = r.Id,
      UserName = r.Reviewee.Name ?? r.Reviewee.UserName ?? "Unknown",
      Rating = r.Rating,
      Content = r.Content,
      BlockchainSignature = r.BlockchainReference,
      CreatedAt = r.CreatedAt
    })
    .ToListAsync();
  }

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    var UserId = UserManager.GetUserId(user);

    if (string.IsNullOrEmpty(UserId))
    {
      IsLoading = false;
      return;
    }

    await LoadReviews(UserId);

    IsLoading = false;
  }
}