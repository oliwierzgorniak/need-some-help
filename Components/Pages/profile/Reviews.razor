@page "/profile/{UserId}/reviews"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using NeedSomeHelp.Data
@using NeedSomeHelp.Components.Shared
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>@($"Reviews for {UserName}")</PageTitle>

<ReviewsTemplate BackUrl="@($"/profile/{UserId}")" Title="@($"Reviews for {UserName}")" IsLoading="@IsLoading"
  reviews="@reviews" />

@code {
  [Parameter]
  public string UserId { get; set; } = string.Empty;

  private bool IsLoading = true;
  private string UserName = "User";
  private List<ReviewsTemplate.ReviewItem> reviews = new();

  private async Task LoadName(string userId)
  {
    if (!string.IsNullOrEmpty(userId))
    {
      using var dbContext = await DbContextFactory.CreateDbContextAsync();
      var user = await dbContext.Users.FindAsync(userId);
      if (user != null)
        UserName = user.Name ?? user.UserName ?? "User";
    }
  }

  private async Task LoadReviews(string userId)
  {
    using var dbContext = await DbContextFactory.CreateDbContextAsync();
    // 2. Fetch reviews where RevieweeId == UserId
    reviews = await dbContext.Reviews
    .Where(r => r.RevieweeId == userId)
    .Include(r => r.Reviewer)
    .OrderByDescending(r => r.CreatedAt)
    .Select(r => new ReviewsTemplate.ReviewItem
    {
      Id = r.Id,
      UserName = r.Reviewer.Name ?? r.Reviewer.UserName ?? "Unknown",
      Rating = r.Rating,
      Content = r.Content,
      BlockchainSignature = r.BlockchainReference,
      CreatedAt = r.CreatedAt
    })
    .ToListAsync();
  }

  protected override async Task OnInitializedAsync()
  {
    if (string.IsNullOrEmpty(UserId))
    {
      IsLoading = false;
      return;
    }

    await LoadName(UserId);

    // 2. Fetch reviews where RevieweeId == UserId
    await LoadReviews(UserId);

    IsLoading = false;
  }
}