<div>
  <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="header-section">
    <RadzenImage Path="@($"assets/users/{UserId}.png")" class="avatar-image" />
    <RadzenStack Gap="0.2rem">
      <RadzenText Text="Josephine" TextStyle="TextStyle.H3" class="user-name" />
      <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.15rem">
          <RadzenText Text="4.9" TextStyle="TextStyle.H5" class="rating-value" />
          <RadzenIcon Icon="star" class="star-icon icon-filled" />
        </RadzenStack>
        <RadzenText Text="(55 reviews)" TextStyle="TextStyle.Body2" class="review-count" />
      </RadzenStack>
    </RadzenStack>
  </RadzenStack>
</div>
<div class="divider"></div>

@code {
  [Parameter]
  public string UserId { get; set; }
}