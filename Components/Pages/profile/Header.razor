@using NeedSomeHelp.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext DbContext

<div>
  <RadzenStack Gap="0.9rem" class="header-section">
    <RadzenText Text="@(User?.Name ?? "Loading...")" TextStyle="TextStyle.H3" TagName="TagName.H1" class="user-name" />
    <RadzenStack Gap="0.3rem">
      <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.15rem">
        <RadzenText Text="@($"{ReviewRating:F1}")" TextStyle="TextStyle.H5" class="rating-value" />
        <RadzenIcon Icon="star" class="star-icon icon-filled" />
      </RadzenStack>
      <RadzenText Text="@($"{ReviewCount} reviews")" TextStyle="TextStyle.Body2" class="review-count" />
    </RadzenStack>
  </RadzenStack>
</div>
<div class="divider"></div>

@code {
  [Parameter]
  public string UserId { get; set; } = string.Empty;

  private ApplicationUser? User;
  private double ReviewRating = 0.0;
  private int ReviewCount = 0;

  protected override async Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(UserId))
    {
      User = await UserManager.FindByIdAsync(UserId);
    }
    else
    {
      var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userPrincipal = authState.User;

      if (userPrincipal.Identity is not null && userPrincipal.Identity.IsAuthenticated)
      {
        User = await UserManager.GetUserAsync(userPrincipal);
      }
    }

    await HandleReviews();
  }

  private async Task HandleReviews()
  {
    var reviews = await DbContext.Reviews
    .Where(r => r.RevieweeId == UserId)
    .ToListAsync();

    ReviewCount = reviews.Count;
    if (ReviewCount > 0)
    {
      ReviewRating = reviews.Average(r => r.Rating);
    }
  }
}