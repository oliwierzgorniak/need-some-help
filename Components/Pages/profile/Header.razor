<div>
  <RadzenStack Gap="0.9rem" class="header-section">
    <RadzenText Text="Josephine" TextStyle="TextStyle.H3" TagName="TagName.H1" class="user-name" />
    <RadzenStack Gap="0.3rem">
      <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.15rem">
        <RadzenText Text="4.9" TextStyle="TextStyle.H5" class="rating-value" />
        <RadzenIcon Icon="star" class="star-icon icon-filled" />
      </RadzenStack>
      <RadzenText Text="55 reviews" TextStyle="TextStyle.Body2" class="review-count" />
    </RadzenStack>
  </RadzenStack>
</div>
<div class="divider"></div>

@code {
  [Parameter]
  public string UserId { get; set; }
}