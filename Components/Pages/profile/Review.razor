@page "/profile/{UserId}/review"
@using NeedSomeHelp.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@using Radzen
@using Radzen.Blazor
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime JSRuntime
@inject TooltipService TooltipService

<PageTitle>Give Review</PageTitle>

<div class="outer-container">
  <a href="@($"/profile/{UserId}")" class="arrow-back">
    <RadzenIcon Icon="arrow_back" />
  </a>
  <RadzenTemplateForm Class="form" Data="@model"
    Submit="@(async (ReviewFormModel args) => await OnGiveReviewClick(args))">
    <RadzenStack Gap="0" class="header-section">
      <RadzenText Text="@userName" TextStyle="TextStyle.H3" class="user-name" />
      <RadzenStack Gap="0.5rem" JustifyContent="JustifyContent.Start">
        <RadzenDropDown @bind-Value=@model.SelectedHelpRequestId Data=@helpRequests TextProperty="Title"
          ValueProperty="Id" Name="SelectedHelpRequestId" Placeholder="Select a request..." class="dropdown" />
        <RadzenRequiredValidator Component="SelectedHelpRequestId" Text="Please select a request" DefaultValue="0" />
      </RadzenStack>
    </RadzenStack>
    <RadzenRating Stars="5" @bind-Value="model.Rating" class="rating-control" Name="Rating" />
    <RadzenStack Gap="0" AlignItems="AlignItems.Center" class="review-input-container">
      <RadzenTextArea Value="@model.ReviewText" ValueChanged="@(args => { model.ReviewText = args; })"
        class="review-input" Placeholder="Write your review here..." Name="ReviewText" MaxLength="50" Rows="3" />
      <RadzenText TextStyle="TextStyle.Caption" class="char-count">
        @(model.ReviewText?.Length ?? 0)/50 max characters
      </RadzenText>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
      <RadzenLabel class="crypto-switch">
        <RadzenIcon Icon="info"
          MouseEnter="@(args => TooltipService.Open(args, "Cryptoreviews are more credible", new TooltipOptions { }))"
          MouseLeave="@(args => TooltipService.Close())" />
        Crypto review
      </RadzenLabel>
      <RadzenSwitch @bind-Value="model.IsCryptoReview" Style="SwitchStyle.Primary" />
    </RadzenStack>
    <RadzenButton ButtonType="ButtonType.Submit" Text="Give review" class="review-button" />
  </RadzenTemplateForm>
</div>

@code {
  [Parameter]
  public string UserId { get; set; } = String.Empty;

  class ReviewFormModel
  {
    public int Rating { get; set; }
    public string ReviewText { get; set; } = "";
    public bool IsCryptoReview { get; set; } = false;
    public int SelectedHelpRequestId { get; set; }
  }

  ReviewFormModel model = new ReviewFormModel();

  private string userName = "User";
  private List<HelpRequest> helpRequests = new();

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;

    if (!string.IsNullOrEmpty(UserId))
    {
      var otherUser = await DbContext.Users.FindAsync(UserId);
      if (otherUser != null)
        userName = otherUser.Name ?? otherUser.UserName ?? "User";
    }

    if (user.Identity is { IsAuthenticated: true })
    {
      var loggedInUserId = UserManager.GetUserId(user);
      if (!string.IsNullOrEmpty(loggedInUserId))
      {
        helpRequests = await DbContext.HelpRequests
        .Where(hr => hr.OwnerId == loggedInUserId
        && hr.ContactedByUsers.Any(c => c.Id == UserId)
        && !DbContext.Reviews.Any(r => r.HelpRequestId == hr.Id && r.ReviewerId == loggedInUserId && r.RevieweeId == UserId))
        .ToListAsync();
      }
    }
  }

  private string _signature = String.Empty;

  private async Task OnGiveReviewClick(ReviewFormModel args)
  {
    if (args.IsCryptoReview)
    {
      try
      {
        _signature = await JSRuntime.InvokeAsync<string>("solanaInterop.giveReview", args.Rating, args.ReviewText);
        Console.WriteLine($"Crypto review submitted with signature: {_signature}");
      }
      catch (Exception ex)
      {
        Console.WriteLine($"Error during crypto review: {ex.Message}");
      }
    }

    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    if (user.Identity is { IsAuthenticated: false }) return;

    var reviewerId = UserManager.GetUserId(user);
    if (!string.IsNullOrEmpty(reviewerId))
    {
      var review = new NeedSomeHelp.Data.Review
      {
        Rating = args.Rating,
        Content = args.ReviewText,
        ReviewerId = reviewerId,
        RevieweeId = UserId,
        HelpRequestId = args.SelectedHelpRequestId,
        CreatedAt = DateTime.UtcNow,
        BlockchainReference = _signature
      };

      DbContext.Reviews.Add(review);
      await DbContext.SaveChangesAsync();
    }

    NavigationManager.NavigateTo($"/profile/{UserId}");
  }
}