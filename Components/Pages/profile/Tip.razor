@page "/profile/{UserId}/tip"
@using NeedSomeHelp.Data
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IJSRuntime JSRuntime

@using Solnet.Rpc;
@using Solnet.Programs;
@using Solnet.Wallet;

<div class="tip-container">
  <RadzenStack Gap="1.5rem">
    <a href="@($"/profile/{UserId}")" class="arrow-back">
      <RadzenIcon Icon="arrow_back" />
    </a>

    <!-- Wallet Connection Status -->
    @if (string.IsNullOrEmpty(userWalletAddress))
    {
      <RadzenButton Text="Connect crypto wallet" Click="ConnectWallet" Variant="Variant.Outlined" />
    }
    else
    {
      <div class="wallet-info">
        <div>Connected: @ShortenAddress(userWalletAddress)</div>
        <div class="wallet-info__amount">Balance: @userBalance.ToString("F4") SOL</div>
      </div>
    }

    <RadzenStack AlignItems="AlignItems.Center" Gap="1rem" class="container">
      <RadzenText TextStyle="TextStyle.H3" Class="user-name">@userName</RadzenText>
      <RadzenImage Path="assets/profile/arrow-up.svg" Height="45px" Width="15px" />
      <RadzenStack Gap="0.3rem">
        <InputNumber @bind-Value="TipAmount" class="tip-amount-input" Min="0" Step="0.001" />
        <RadzenText Text="solana" TextStyle="TextStyle.Body1" class="tip-subtitle" />
      </RadzenStack>
    </RadzenStack>

    <!-- Send Button -->
    <RadzenButton Text="Send tip" class="send-button" Click="SendTip"
      Disabled="@(string.IsNullOrEmpty(userWalletAddress))" />

    @if (!string.IsNullOrEmpty(statusMessage))
    {
      <RadzenText TextStyle="TextStyle.Caption" Style="text-align: center; color: var(--rz-danger);">@statusMessage
      </RadzenText>
    }
  </RadzenStack>
</div>

@code {
  [Parameter]
  public string UserId { get; set; } = string.Empty;

  private decimal TipAmount { get; set; } = 0.010m;

  // Wallet State
  private string userWalletAddress = "";
  private double userBalance = 0;
  private string statusMessage = "";

  private void SetAmount(decimal amount)
  {
    TipAmount = amount;
  }

  private string userName = "User";
  private async Task LoadName()
  {
    if (!string.IsNullOrEmpty(UserId))
    {
      using var dbContext = await DbContextFactory.CreateDbContextAsync();
      var otherUser = await dbContext.Users.FindAsync(UserId);
      if (otherUser != null)
        userName = otherUser.Name ?? otherUser.UserName ?? "User";
    }
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadName();
  }

  private async Task ConnectWallet()
  {
    try
    {
      statusMessage = "";
      userWalletAddress = await JSRuntime.InvokeAsync<string>("solanaInterop.connect");

      if (!string.IsNullOrEmpty(userWalletAddress))
      {
        var rpcClient = ClientFactory.GetClient("https://api.devnet.solana.com");
        var balanceResult = await rpcClient.GetBalanceAsync(userWalletAddress);

        if (balanceResult.WasSuccessful)
        {
          // Convert Lamports (10^-9) to SOL
          userBalance = (double)balanceResult.Result.Value / 1_000_000_000;
        }
        else
        {
          statusMessage = "Could not fetch balance from Network. Is network running?";
        }
      }
    }
    catch (Exception ex)
    {
      statusMessage = $"Connection failed: {ex.Message} (Is network set to Localhost?)";
      Console.WriteLine(ex);
    }
  }

  private string ShortenAddress(string address)
  {
    if (address.Length < 10) return address;
    return $"{address.Substring(0, 4)}...{address.Substring(address.Length - 4)}";
  }

  private async Task SendTip()
  {
    if (string.IsNullOrEmpty(userWalletAddress)) return;

    try
    {
      using var dbContext = await DbContextFactory.CreateDbContextAsync();
      // 1. Get Recipient Wallet from DB
      var otherUser = await dbContext.Users.FindAsync(UserId);
      if (otherUser == null || string.IsNullOrEmpty(otherUser.Wallet))
      {
        statusMessage = "User that you're sending to has not connected a wallet yet.";
        return;
      }

      var signature = await JSRuntime.InvokeAsync<string>(
      "solanaInterop.sendTip",
      otherUser.Wallet,
      TipAmount
      );

      if (!string.IsNullOrEmpty(signature))
      {
        statusMessage = "";
      }
    }
    catch (Exception ex)
    {
      statusMessage = $"Transaction failed: {ex.Message}";
      Console.WriteLine(ex);
    }
  }
}