@page "/profile/{UserId}/review"
@inject NavigationManager NavigationManager
@using Radzen
@using Radzen.Blazor

<PageTitle>Give Review</PageTitle>

<div class="review-container">
  <a href=".." class="back-button">
    <RadzenIcon Icon="arrow_back" />
  </a>
  <RadzenStack Gap="0" class="header-section">
    <RadzenText Text="Josephine" TextStyle="TextStyle.H3" class="user-name" />
    <RadzenText Text="Help with gardening" TextStyle="TextStyle.Body1" class="sub-text" />
  </RadzenStack>
  <RadzenRating Stars="5" @bind-Value="Rating" class="rating-control" />
  <RadzenTextArea @bind-Value="ReviewText" class="review-input" Placeholder="Write your review here..." />
  <RadzenButton Text="Give review" class="review-button" />
</div>

@code {
  [Parameter]
  public string UserId { get; set; }

  public int Rating { get; set; }
  public string ReviewText { get; set; } = "";
}