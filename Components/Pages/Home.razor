@page "/"
@using Microsoft.EntityFrameworkCore
@using NeedSomeHelp.Data
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@rendermode RenderMode.InteractiveServer

<PageTitle>Home</PageTitle>



@if (isChecking)
{
    <div class="loading-container">
        <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate"
            Size="ProgressBarCircularSize.Medium" />
    </div>
}
else
{
    <div class="home-container">
        <div class="cards-grid">
            @foreach (var request in requests)
            {
                <RequestCard Id="@request.Id" Location="@request.Location" Title="@request.Title"
                    PhotoUrl="@request.PhotoUrl" />
            }
        </div>
        <Nav />
    </div>
}

@code {
    private bool isChecking = true;

    private class RequestItem
    {
        public int Id { get; set; }
        public required string Title { get; set; }
        public required string Location { get; set; }
        public string? PhotoUrl { get; set; }
    }

    private List<RequestItem> requests = new();

    protected override async Task OnInitializedAsync()
    {
        // Fetch HelpRequests from the database
        using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var dbRequests = await dbContext.HelpRequests
        .OrderByDescending(r => r.CreatedAt)
        .ToListAsync();

        requests = dbRequests.Select(r => new RequestItem
        {
            Id = r.Id,
            Title = r.Title,
            Location = r.Location,
            PhotoUrl = r.PhotoUrl
        }).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var hasVisited = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "hasVisited");

            if (string.IsNullOrEmpty(hasVisited))
            {
                // First time visit
                NavigationManager.NavigateTo("/onboarding/1");
                return;
            }
            else
            {
                // Already visited
                isChecking = false;
                StateHasChanged();
            }
        }
    }
}