@page "/add-request"
@using NeedSomeHelp.Components.Layout
@using NeedSomeHelp.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Azure.Storage.Blobs
@using Azure.Storage.Blobs.Models
@using Azure.Storage.Sas
@using Azure
@using Azure.AI.ContentSafety
@using System.IO
@inject NavigationManager NavigationManager
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration

<PageTitle>Add Request</PageTitle>


<div class="page-container">
    <a href="/" class="arrow-back">
        <RadzenIcon Icon="arrow_back" Click="@(() => NavigationManager.NavigateTo("/"))" />
    </a>
    <RadzenTemplateForm Data="@model" Submit="@(async (RequestFormModel args) => await OnRequestSubmit(args))">
        <RadzenStack Gap="0.7rem" class="form-wrapper">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div
                    style="color: red; background-color: #ffe6e6; padding: 10px; border-radius: 5px; border: 1px solid red; margin-bottom: 10px;">
                    @errorMessage
                </div>
            }
            <RadzenStack Gap="0.5rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
                class="photo-upload-area" Style="@($"background-image: url('{model.PhotoUrl}');")">
                <label class="upload-label">
                    <InputFile OnChange="@UploadPhoto" accept="image/*" class="upload-input" />
                    @if (isUploading)
                    {
                        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                            Size="ProgressBarCircularSize.Medium" class="upload-spinner" />
                    }
                    else
                    {
                        <RadzenIcon Icon="add" class="upload-icon" />
                    }
                </label>

                <RadzenText Text="Photo" TextStyle="TextStyle.H4" class="photo-text" />
            </RadzenStack>
            <RadzenStack Gap="1rem" class="inputs-section">
                <!-- Title -->
                <RadzenFormField Text="Title" Variant="Variant.Outlined" class="full-width">
                    <RadzenTextBox @bind-Value="@model.Title" Name="Title" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="Title" Text="Title is required" />
                <!-- Description -->
                <RadzenStack Gap="0.5rem" AlignItems="AlignItems.End" class="description-wrapper">
                    <RadzenFormField Text="Description" Variant="Variant.Outlined" class="full-width">
                        <RadzenTextArea @bind-Value="@model.Description" Name="Description" Rows="4" MaxLength="400" />
                    </RadzenFormField>
                    <RadzenText TextStyle="TextStyle.Caption" class="char-count">
                        @(model.Description?.Length ?? 0)/400 max characters
                    </RadzenText>
                </RadzenStack>
                <!-- Location -->
                <RadzenStack Gap="0.7rem">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenFormField Text="Location" Variant="Variant.Outlined" class="location-field">
                            <RadzenTextBox @bind-Value="@model.Location" Name="Location" />
                        </RadzenFormField>
                        <RadzenButton Icon="location_on" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                            Click="@GetLocation" class="location-button" />
                    </RadzenStack>
                    <!-- Is help remote? -->
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox @bind-Value="@model.IsRemote" Name="IsRemote" />
                        <RadzenLabel Text="Is help remote?" Component="IsRemote" class="checkbox-label" />
                    </RadzenStack>
                </RadzenStack>
                <!-- Phone Section -->
                <RadzenStack Gap="0.7rem">
                    <RadzenFormField Text="Phone" Variant="Variant.Outlined" class="full-width">
                        <RadzenTextBox @bind-Value="@model.PhoneNumber" Name="PhoneNumber" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox @bind-Value="@model.UseMyPhone" Name="UseMyPhone" />
                        <RadzenLabel Text="I want to use my phone" Component="UseMyPhone" class="checkbox-label" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenStack>
            <!-- Add Request Button -->
            <RadzenButton ButtonType="ButtonType.Submit" Text="Add request" ButtonStyle="ButtonStyle.Primary"
                Variant="Variant.Flat" class="submit-button" />
        </RadzenStack>
    </RadzenTemplateForm>
</div>

@code {
    class RequestFormModel
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Location { get; set; } = "";
        public bool IsRemote { get; set; }
        public string PhoneNumber { get; set; } = "";
        public bool UseMyPhone { get; set; }
        public string? PhotoUrl { get; set; }
    }

    RequestFormModel model = new RequestFormModel();
    bool isUploading = false;
    string errorMessage = "";

    async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            var format = "image/jpeg";
            var resizedImageFile = await file.RequestImageFileAsync(format, 1000, 1000);

            var blobServiceClient = new BlobServiceClient(Configuration["Azure:Storage:ConnectionString"]);
            var containerClient = blobServiceClient.GetBlobContainerClient("requests");

            bool isPrivate = false;
            try
            {
                await containerClient.CreateIfNotExistsAsync(PublicAccessType.Blob);
            }
            catch (RequestFailedException ex) when (ex.ErrorCode == "PublicAccessNotPermitted")
            {
                // Storage account doesn't support public access. Create private container.
                isPrivate = true;
                await containerClient.CreateIfNotExistsAsync();
            }

            // Double check existing container properties if we didn't catch an exception (in case it already existed as private)
            if (!isPrivate && await containerClient.ExistsAsync())
            {
                var properties = await containerClient.GetPropertiesAsync();
                if (properties.Value.PublicAccess == PublicAccessType.None)
                {
                    isPrivate = true;
                }
            }

            var blobName = $"{Guid.NewGuid()}.jpg";
            var blobClient = containerClient.GetBlobClient(blobName);

            using var stream = resizedImageFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            await blobClient.UploadAsync(stream, new BlobHttpHeaders { ContentType = format });

            if (isPrivate)
            {
                // Generate a SAS token valid for 5 years for simple public access
                var sasBuilder = new BlobSasBuilder
                {
                    BlobContainerName = containerClient.Name,
                    BlobName = blobName,
                    Resource = "b",
                    ExpiresOn = DateTimeOffset.UtcNow.AddYears(5)
                };
                sasBuilder.SetPermissions(BlobSasPermissions.Read);
                var sasUri = blobClient.GenerateSasUri(sasBuilder);
                model.PhotoUrl = sasUri.ToString();
            }
            else
            {
                model.PhotoUrl = blobClient.Uri.ToString();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading photo: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }

    async Task OnRequestSubmit(RequestFormModel args)
    {
        errorMessage = "";

        if (!await IsContentSafe(args.Title, args.Description, args.PhotoUrl))
        {
            errorMessage = "Your content was flagged as unsafe. Please remove any inappropriate text or images.";
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        Console.WriteLine("Submitting request");

        if (user.Identity?.IsAuthenticated == true)
        {
            var currentUser = await UserManager.GetUserAsync(user);
            if (currentUser != null)
            {
                var newRequest = new HelpRequest
                {
                    Title = args.Title,
                    Description = args.Description,
                    Location = args.Location,
                    PhoneNumber = args.UseMyPhone ? currentUser.PhoneNumber : args.PhoneNumber,
                    OwnerId = currentUser.Id,
                    PhotoUrl = args.PhotoUrl,
                    CreatedAt = DateTime.UtcNow
                };

                DbContext.HelpRequests.Add(newRequest);
                await DbContext.SaveChangesAsync();

                NavigationManager.NavigateTo("/");
            }
        }
        else
        {
            NavigationManager.NavigateTo("Identity/Account/Login", true);
        }
    }

    void GetLocation()
    {
        // TODO: Implement geolocation fetch
        model.Location = "Current Location"; // Placeholder
    }

    async Task<bool> IsContentSafe(string title, string description, string? photoUrl)
    {
        var endpoint = Configuration["Azure:ContentSafety:Endpoint"];
        var key = Configuration["Azure:ContentSafety:Key"];

        if (string.IsNullOrEmpty(endpoint) || string.IsNullOrEmpty(key)) return true;

        try
        {
            var client = new ContentSafetyClient(new Uri(endpoint), new AzureKeyCredential(key));

            // Text Analysis
            var text = (title + " " + description).Trim();
            if (!string.IsNullOrEmpty(text))
            {
                var textOptions = new AnalyzeTextOptions(text);
                var response = await client.AnalyzeTextAsync(textOptions);
                if (response.Value.CategoriesAnalysis.Any(c => c.Severity >= 2)) return false;
            }

            // Image Analysis
            if (!string.IsNullOrEmpty(photoUrl))
            {
                using var http = new HttpClient();
                // Download the image data
                var imageBytes = await http.GetByteArrayAsync(photoUrl);
                var imageData = new ContentSafetyImageData(new BinaryData(imageBytes));
                var imageOptions = new AnalyzeImageOptions(imageData);

                var imageResponse = await client.AnalyzeImageAsync(imageOptions);
                if (imageResponse.Value.CategoriesAnalysis.Any(c => c.Severity >= 2)) return false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Content Validation Error: {ex.Message}");
        }

        return true;
    }
}