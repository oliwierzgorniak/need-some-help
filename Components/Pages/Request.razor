@page "/request/{Id}"
@inject NavigationManager NavigationManager
@using Humanizer
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NeedSomeHelp.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IJSRuntime JSRuntime

<PageTitle>Request Details</PageTitle>


<div class="request-container">
    <RadzenButton Icon="arrow_back" Class="back-button" ButtonStyle="ButtonStyle.Secondary" Style="min-width: auto;"
        Click="@(() => NavigationManager.NavigateTo("/"))" />

    @if (request != null)
    {
        <RadzenImage Path="@(string.IsNullOrEmpty(request.PhotoUrl) ? "assets/request-no-picture.jpg" : request.PhotoUrl)"
            class="image" Style="object-fit: cover;" />
    }
    else
    {
        <div class="image" style="background-color: #eee;"></div>
    }
    <RadzenStack Gap="1.1rem" class="content-stack">
        <RadzenStack Gap="0.25rem">
            <RadzenText Text="@($"Added: {request?.CreatedAt.ToString("dd.MM.yyyy") ?? "Loading..."}")"
                TextStyle="TextStyle.Body2" class="date-text" />
            <RadzenText Text="@(request?.Title ?? "Loading...")" TextStyle="TextStyle.H4" class="title" />
        </RadzenStack>
        <div class="divider"></div>
        @if (request?.Description.Length > 0)
        {
            <RadzenText Text="@(request?.Description ?? "Loading...")" TextStyle="TextStyle.Body1"
                class="description-text" />
            <div class="divider"></div>
        }
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.7rem">
            <RadzenStack Gap="0.4rem" class="user-info-flex">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.7rem" AlignItems="AlignItems.Center">
                    <RadzenText Text="@(owner?.Name ?? owner?.UserName ?? "User")" TextStyle="TextStyle.H5"
                        TagName="TagName.H2" class="user-name" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.45rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.15rem">
                        <RadzenIcon Icon="star" class="star-icon" />
                        <RadzenText Text="@ReviewRating.ToString("F1")" TextStyle="TextStyle.Body1"
                            class="rating-text" />
                    </RadzenStack>
                    <RadzenText Text="@($"{ReviewCount} reviews")" TextStyle="TextStyle.Caption" class="reviews-text" />
                </RadzenStack>
            </RadzenStack>
        </RadzenStack>
        <div class="divider"></div>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="Location" TextStyle="TextStyle.H5" class="location-title" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                AlignItems="AlignItems.Center">
                <RadzenText Text="@(request?.Location ?? "Unknown Location")" TextStyle="TextStyle.Body2"
                    class="address-text" />
            </RadzenStack>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.6rem"
            class="action-buttons-container">
            <RadzenButton Click="@OnShareClick" Icon="ios_share" class="action-btn share-btn" />
            @if (!_isOwnRequest)
            {
                @if (!string.IsNullOrEmpty(request?.PhoneNumber))
                {
                    @if (_isAuthenticated)
                    {
                        <a href="@($"tel:{request.PhoneNumber}")" @onclick="AddToChats" class="phone-btn">
                            <RadzenButton Icon="phone" Style="pointer-events: none;" />
                        </a>
                    }
                    else
                    {
                        <a href="@($"/register?ReturnUrl={Uri.EscapeDataString(_returnUrl)}")" class="phone-btn">
                            <RadzenButton Icon="phone" />
                        </a>
                    }
                }
                <RadzenButton Icon="message" class="action-btn message-btn" Click="@OnMessageClick" />
            }
        </RadzenStack>
    </RadzenStack>

</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private HelpRequest? request;
    private ApplicationUser? owner;

    private string _returnUrl = "/";

    protected override void OnInitialized()
    {
        _returnUrl = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(Id, out int requestId))
        {
            using var dbContext = await DbContextFactory.CreateDbContextAsync();
            request = await dbContext.HelpRequests
            .Include(r => r.Owner)
            .FirstOrDefaultAsync(r => r.Id == requestId);

            if (request != null)
            {
                owner = request.Owner;
                await HandleReviews(owner, dbContext);
            }
        }

        await UpdateIsOwnRequest();
    }
    private bool _isOwnRequest = false;

    private bool _isAuthenticated = false;


    async Task UpdateIsOwnRequest()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (_isAuthenticated && request != null)
        {
            var userId = UserManager.GetUserId(user);
            _isOwnRequest = userId == request.OwnerId;
        }
    }



    async Task<Boolean> AddToChats()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo($"/register?ReturnUrl={Uri.EscapeDataString(_returnUrl)}", true);
            return false;
        }

        if (request != null)
        {
            var userId = UserManager.GetUserId(user);
            using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var currentUser = await dbContext.Users
            .Include(u => u.ContactedRequests)
            .FirstOrDefaultAsync(u => u.Id == userId);

            if (currentUser != null && userId != null)
            {
                // Check if already contacted
                if (!currentUser.ContactedRequests.Any(r => r.RequestId == request.Id))
                {
                    currentUser.ContactedRequests.Add(new ContactedHelpRequest
                    {
                        UserId = userId,
                        User = currentUser,
                        RequestId = request.Id,
                        CreatedAt = DateTime.UtcNow
                    });
                    await dbContext.SaveChangesAsync();
                }
            }
        }

        return true;
    }


    @* Reviews *@
    public int ReviewCount = 0;
    public double ReviewRating = 0.0;

    private async Task HandleReviews(ApplicationUser owner, ApplicationDbContext dbContext)
    {
        var reviews = await dbContext.Reviews
        .Where(r => r.RevieweeId == owner.Id)
        .ToListAsync();

        ReviewCount = reviews.Count;
        if (ReviewCount > 0)
        {
            ReviewRating = reviews.Average(r => r.Rating);
        }
    }


    @* Handling buttons *@
    async Task OnMessageClick()
    {
        await AddToChats();
        NavigationManager.NavigateTo("/chats");
    }
    private async Task OnPhoneClick()
    {
        @* Doesn't continue if add to chats fails *@
        if (!await AddToChats()) return;

        if (!string.IsNullOrEmpty(request?.PhoneNumber))
        {
            await JSRuntime.InvokeVoidAsync("communicationInterop.call", request.PhoneNumber);
        }
    }
    private Task OnShareClick()
    {
        JSRuntime.InvokeVoidAsync("communicationInterop.share");
        return Task.CompletedTask;
    }

}