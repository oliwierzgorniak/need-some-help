@page "/request/{Id}"
@inject NavigationManager NavigationManager
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using NeedSomeHelp.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<PageTitle>Request Details</PageTitle>


<div class="request-container">
    <RadzenButton Icon="arrow_back" Class="back-button" ButtonStyle="ButtonStyle.Secondary" Style="min-width: auto;"
        Click="@(() => NavigationManager.NavigateTo("/"))" />

    @if (request != null)
    {
        <RadzenImage Path="@(string.IsNullOrEmpty(request.PhotoUrl) ? "assets/requests/1.png" : request.PhotoUrl)"
            class="image" Style="object-fit: cover;" />
    }
    else
    {
        <div class="image" style="background-color: #eee;"></div>
    }
    <RadzenStack Gap="1.1rem" class="content-stack">
        <RadzenStack Gap="0.25rem">
            <RadzenText Text="@($"Added: {request?.CreatedAt.ToString("dd.MM.yyyy") ?? "Loading..."}")"
                TextStyle="TextStyle.Body2" class="date-text" />
            <RadzenText Text="@(request?.Title ?? "Loading...")" TextStyle="TextStyle.H4" class="title" />
        </RadzenStack>
        <div class="divider"></div>
        <RadzenText Text="@(request?.Description ?? "Loading...")" TextStyle="TextStyle.Body1"
            class="description-text" />
        <div class="divider"></div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.7rem">
            <RadzenStack Gap="0.4rem" class="user-info-flex">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.7rem" AlignItems="AlignItems.Center">
                    <RadzenText Text="@(owner?.Name ?? owner?.UserName ?? "User")" TextStyle="TextStyle.H5"
                        TagName="TagName.H2" class="user-name" />
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.15rem"
                        Style="cursor: pointer;">
                        <RadzenIcon Icon="flag" class="report-icon icon-filled" />
                        <RadzenText Text="Report" TextStyle="TextStyle.Caption" class="report-text" />
                    </RadzenStack>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.45rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.15rem">
                        <RadzenIcon Icon="star" class="star-icon" />
                        <RadzenText Text="@ReviewRating.ToString("F1")" TextStyle="TextStyle.Body1"
                            class="rating-text" />
                    </RadzenStack>
                    <RadzenText Text="@($"{ReviewCount} reviews")" TextStyle="TextStyle.Caption" class="reviews-text" />
                </RadzenStack>
                @* <RadzenText Text="Last login: today" TextStyle="TextStyle.Body2" class="login-text" /> *@
            </RadzenStack>
        </RadzenStack>
        <div class="divider"></div>
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="Location" TextStyle="TextStyle.H5" class="location-title" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                AlignItems="AlignItems.Center">
                <RadzenText Text="@(request?.Location ?? "Unknown Location")" TextStyle="TextStyle.Body2"
                    class="address-text" />
            </RadzenStack>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.6rem"
            class="action-buttons-container">
            <RadzenButton Icon="ios_share" class="action-btn share-btn" />
            <RadzenButton Icon="phone" class="action-btn phone-btn" />
            <RadzenButton Icon="message" class="action-btn message-btn" Click="@OnMessageClick" />
        </RadzenStack>
    </RadzenStack>

</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private HelpRequest? request;
    private ApplicationUser? owner;

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(Id, out int requestId))
        {
            request = await DbContext.HelpRequests
            .Include(r => r.Owner)
            .FirstOrDefaultAsync(r => r.Id == requestId);

            if (request != null)
            {
                owner = request.Owner;
                await HandleReviews(owner);
            }
        }
    }

    async Task OnMessageClick()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("Identity/Account/Login", true);
            return;
        }

        if (request != null)
        {
            var userId = UserManager.GetUserId(user);

            // Don't let users message themselves
            if (userId == request.OwnerId)
            {
                NavigationManager.NavigateTo($"/chat/{request.Id}"); // Or just go to chats main list?
                return;
            }

            var currentUser = await DbContext.Users
            .Include(u => u.ContactedHelpRequests)
            .FirstOrDefaultAsync(u => u.Id == userId);

            if (currentUser != null)
            {
                // Check if already contacted
                if (!currentUser.ContactedHelpRequests.Any(r => r.Id == request.Id))
                {
                    currentUser.ContactedHelpRequests.Add(request);
                    await DbContext.SaveChangesAsync();
                }

                NavigationManager.NavigateTo($"/chat/{request.Id}");
            }
        }
    }

    public int ReviewCount = 0;
    public double ReviewRating = 0.0;

    private async Task HandleReviews(ApplicationUser owner)
    {
        var reviews = await DbContext.Reviews
        .Where(r => r.RevieweeId == owner.Id)
        .ToListAsync();

        ReviewCount = reviews.Count;
        if (ReviewCount > 0)
        {
            ReviewRating = reviews.Average(r => r.Rating);
        }
    }
}