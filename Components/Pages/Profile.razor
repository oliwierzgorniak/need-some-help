@page "/profile/{UserId}"
@using Microsoft.EntityFrameworkCore
@using NeedSomeHelp.Data
@inject NavigationManager NavigationManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@using Radzen
@using Radzen.Blazor
@using NeedSomeHelp.Components.Pages.profile

<PageTitle>Profile</PageTitle>

<div class="profile-container">
  <a href="/chats" class="arrow-back">
    <RadzenIcon Icon="arrow_back" />
  </a>
  <RadzenStack Gap="0" class="menu-list">
    <Header UserId="@UserId" />
    <Link Url="@($"/profile/{UserId}/review")" IconText="stars" Text="Give review" />
    @if (_hasWallet)
    {
      <div class="divider"></div>
      <Link Url="@($"/profile/{UserId}/tip")" IconText="attach_money" Text="Send tip" />
    }
    <div class="divider"></div>
    <Link Url="@($"/profile/{UserId}/reviews")" IconText="reviews" Text="Read reviews" />
  </RadzenStack>
</div>


@code {
  [Parameter]
  public string UserId { get; set; } = string.Empty;
  private bool _hasWallet = false;

  protected override async Task OnInitializedAsync()
  {
    if (!string.IsNullOrEmpty(UserId))
    {
      using var dbContext = await DbContextFactory.CreateDbContextAsync();
      var user = await dbContext.Users.FindAsync(UserId);
      if (user != null && !string.IsNullOrEmpty(user.Wallet))
      {
        _hasWallet = true;
      }
    }
  }
}