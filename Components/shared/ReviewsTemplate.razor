@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using NeedSomeHelp.Data
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime

<div class="container">
  <SecondLevelHeader BackUrl="@BackUrl" Title="@Title" />

  @if (isLoading)
  {
    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium"
      class="loading-spinner" />
  }
  else if (!reviews.Any())
  {
    <RadzenText Text="No reviews yet." TextStyle="TextStyle.Body1" class="empty-state-text" />
  }
  else
  {
    <RadzenStack Gap="1rem" class="reviews-container">
      @foreach (var review in reviews)
      {
        <RadzenCard class="review-card">
          <RadzenStack Gap="0.8rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
              AlignItems="AlignItems.Center">
              <RadzenStack Gap="0.5rem" Orientation="Orientation.Horizontal" AlignItems="AlignItems.End">
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2">@review.UserName</RadzenText>
                @if (!string.IsNullOrEmpty(review.BlockchainSignature))
                {
                  <div @onclick="@(() => CopyToClipboard(review.BlockchainSignature))" style="cursor: pointer;">
                    <RadzenBadge IsPill="true" BadgeSize="BadgeSize.Small" BadgeIcon="attach_money"
                      BadgeStyle="BadgeStyle.Primary">
                      Crypto
                    </RadzenBadge>
                  </div>
                }
              </RadzenStack>
              <RadzenRating Value="@review.Rating" ReadOnly="true" class="rating" />
            </RadzenStack>
            <RadzenStack Gap="0.5rem" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
              AlignItems="AlignItems.Start">
              <RadzenText TextStyle="TextStyle.Body2" class="content">@review.Content</RadzenText>
              <RadzenText TextStyle="TextStyle.Caption" class="created-info">
                @review.CreatedAt.ToString("MMM dd, yyyy")
              </RadzenText>
            </RadzenStack>
          </RadzenStack>
        </RadzenCard>
      }
    </RadzenStack>
  }
</div>

@code {
  [Parameter]
  public string Title { get; set; } = "Title";

  [Parameter]
  public string BackUrl { get; set; } = "/";

  [Parameter]
  public bool isLoading { get; set; } = true;

  [Parameter]
  public List<ReviewItem> reviews { get; set; } = new();

  public class ReviewItem
  {
    public int Id { get; set; }
    public string UserName { get; set; } = "Unknown";
    public int Rating { get; set; }
    public string Content { get; set; } = string.Empty;
    public string? BlockchainSignature { get; set; }
    public DateTime CreatedAt { get; set; }
  }

  public async Task CopyToClipboard(string text)
  {
    try
    {
      await JSRuntime.InvokeVoidAsync("otherInterop.copy", text);
      NotificationService.Notify(new NotificationMessage
      {
        Severity = NotificationSeverity.Info,
        Summary = "Copied to clipboard",
        Duration = 1500,
        Style = "position: fixed; top: 0.1rem; right: 1rem;"
      });
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error copying to clipboard: {ex.Message}");
    }
  }
}