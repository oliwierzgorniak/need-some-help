@page
@model NeedSomeHelp.Pages.RegisterModel
@{
  ViewData["Title"] = "Register";
}

<main>
  <article class="auth">
    <h1 class="auth__title">Register</h1>
    @* We append the ReturnUrl to the form action so it persists on POST *@
    <form method="post" class="auth__form" asp-route-returnUrl="@Model.ReturnUrl">
      <label class="auth__label">
        Name
        <input asp-for="Input.Name" required class="auth__input" />
      </label>
      <label class="auth__label">
        Email
        <input asp-for="Input.Email" required type="email" class="auth__input" />
      </label>
      <label class="auth__label">
        Password
        <input asp-for="Input.Password" type="password" required type="password" class="auth__input" />
      </label>
      <button type="submit" class="auth__submit">Register</button>
      @if (!ModelState.IsValid)
      {
        <div asp-validation-summary="All" class="auth__errors"></div>
      }
    </form>
    <a href="@(Model.ReturnUrl != null ? $"/login?ReturnUrl={Uri.EscapeDataString(Model.ReturnUrl)}" : "/login")"
      class="auth__other-link">Login</a>
  </article>
</main>